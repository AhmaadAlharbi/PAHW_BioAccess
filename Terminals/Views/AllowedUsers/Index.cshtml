@model List<Terminals.Web.DTOs.AllowedUserListItemDto>
@{
    ViewData["Title"] = "إدارة الأعضاء";
    var currentEmpId = Context.Session.GetString("EmpId") ?? "";
}

<div class="allowed-users-page fade-in">
<div class="content-card">

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-error">
            <span class="alert-icon">⚠️</span>
            <span>@TempData["ErrorMsg"]</span>
        </div>
    }
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success">
            <span class="alert-icon">✅</span>
            <span>@TempData["SuccessMsg"]</span>
        </div>
    }

    <div class="allowed-users-header">
        <div class="allowed-users-title">
            <span class="allowed-users-title-icon"><i class="fa-solid fa-user-shield"></i></span>
            <div>
                <h1>إدارة الأعضاء</h1>
                <p>مراجعة الأعضاء المصرح لهم وحالة الحسابات وصلاحيات الإشراف.</p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            <span>إضافة عضو</span>
        </a>
    </div>

    <div class="divider"></div>

    <div class="c-stats-grid">
        <div class="stat-card">
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">إجمالي الأعضاء</div>
        </div>
        <div class="stat-card">
            <div class="stat-value text-emerald">@Model.Count(u => u.IsActive)</div>
            <div class="stat-label">الحسابات النشطة</div>
        </div>
        <div class="stat-card">
            <div class="stat-value text-rose">@Model.Count(u => !u.IsActive)</div>
            <div class="stat-label">الحسابات المعطّلة</div>
        </div>
        <div class="stat-card">
            <div class="stat-value text-blue">@Model.Count(u => u.IsAdmin)</div>
            <div class="stat-label">المشرفون</div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-container allowed-users-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>العضو</th>
                        <th>البريد الإلكتروني</th>
                        <th>القسم</th>
                        <th>نوع المستخدم</th>
                        <th>الحالة</th>
                        <th>صالح حتى</th>
                        <th class="u-text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="allowed-user-cell">
                                    <span class="allowed-user-avatar">
                                        <i class="fa-solid fa-user"></i>
                                    </span>
                                    <span>
                                        <span class="allowed-user-name">@u.FullName</span>
                                        <span class="allowed-user-id">@u.EmployeeId</span>
                                    </span>
                                </div>
                            </td>
                            <td><span class="text-muted">@u.Email</span></td>
                            <td>@u.Department</td>
                            <td>@(u.UserType == "IT" ? "تقنية المعلومات" : "الدوام")</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge badge-success"><i class="fa-solid fa-check"></i> <span>فعال</span></span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fa-solid fa-xmark"></i> <span>معطل</span></span>
                                }
                            </td>
                            <td>
                                @if (u.ValidUntil.HasValue)
                                {
                                    <span class="text-amber u-fw-700">@u.ValidUntil.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">دائم</span>
                                }
                            </td>
                            <td>
                                <div class="c-actions-row">
                                    @if (u.IsAdmin)
                                    {
                                        <span class="badge badge-info"><i class="fa-solid fa-shield-halved"></i> <span>مشرف</span></span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted"><i class="fa-regular fa-user"></i> <span>عضو</span></span>
                                    }

                                    <a asp-action="Edit" asp-route-employeeId="@u.EmployeeId" class="btn btn-sm btn-outline">
                                        <i class="fa-solid fa-pen"></i>
                                        <span>تعديل</span>
                                    </a>

                                    @if (u.EmployeeId.ToString() != currentEmpId)
                                    {
                                        <div class="allowed-row-menu">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline allowed-row-menu-toggle"
                                                    aria-label="فتح إجراءات العضو"
                                                    aria-expanded="false">
                                                <i class="fa-solid fa-ellipsis-vertical"></i>
                                            </button>
                                            <div class="allowed-row-menu-panel is-hidden">
                                                <form method="post" asp-action="ToggleAdmin">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="employeeId" value="@u.EmployeeId" />
                                                    <input type="hidden" name="makeAdmin" value="@(u.IsAdmin ? "false" : "true")" />
                                                    <button type="submit" class="allowed-row-menu-item">
                                                        @if (u.IsAdmin)
                                                        {
                                                            <i class="fa-solid fa-user"></i>
                                                            <span>تحويل لعضو</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-shield-halved"></i>
                                                            <span>ترقية لمشرف</span>
                                                        }
                                                    </button>
                                                </form>
                                                <form method="post" asp-action="Toggle">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="employeeId" value="@u.EmployeeId" />
                                                    <input type="hidden" name="makeActive" value="@(u.IsActive ? "false" : "true")" />
                                                    <button type="submit" class="allowed-row-menu-item">
                                                        @if (u.IsActive) { <i class="fa-solid fa-pause"></i> <span>تعطيل العضو</span> } else { <i class="fa-solid fa-play"></i> <span>تفعيل العضو</span> }
                                                    </button>
                                                </form>
                                                @* <form method="post" asp-action="Delete" class="js-delete-user-form"> *@
                                                @*     @Html.AntiForgeryToken() *@
                                                @*     <input type="hidden" name="employeeId" value="@u.EmployeeId" /> *@
                                                @*     <button type="button" class="allowed-row-menu-item is-danger js-delete-user-btn" *@
                                                @*             data-fullname="@u.FullName"> *@
                                                @*         <i class="fa-solid fa-trash"></i> *@
                                                @*         <span>حذف العضو</span> *@
                                                @*     </button> *@
                                                @* </form> *@
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge badge-copper"><i class="fa-solid fa-lock"></i> <span>حسابك</span></span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📭</div>
            <div class="empty-state-text">لا يوجد أعضاء في القائمة حالياً</div>
            <div class="u-mt-24">
                <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> <span>إضافة عضو</span></a>
            </div>
        </div>
    }

</div>
</div>

@section Scripts {
<script>
    function closeAllowedRowMenus(exceptPanel) {
        document.querySelectorAll('.allowed-row-menu-panel').forEach(function (panel) {
            if (panel === exceptPanel) return;
            panel.classList.add('is-hidden');
            panel.closest('.allowed-row-menu')?.querySelector('.allowed-row-menu-toggle')?.setAttribute('aria-expanded', 'false');
        });
    }

    document.querySelectorAll('.allowed-row-menu-toggle').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var panel = this.closest('.allowed-row-menu')?.querySelector('.allowed-row-menu-panel');
            if (!panel) return;
            var willOpen = panel.classList.contains('is-hidden');
            closeAllowedRowMenus(panel);
            panel.classList.toggle('is-hidden', !willOpen);
            this.setAttribute('aria-expanded', String(willOpen));
        });
    });

    document.addEventListener('click', function (e) {
        if (e.target.closest('.allowed-row-menu')) return;
        closeAllowedRowMenus();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAllowedRowMenus();
    });

    document.querySelectorAll('.js-delete-user-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var fullName = this.dataset.fullname || 'هذا العضو';
            var form = this.closest('form');
            var result = await Swal.fire({
                title: 'تأكيد الحذف',
                text: 'هل أنت متأكد من الحذف النهائي للعضو "' + fullName + '"؟ لا يمكن التراجع عن هذا الإجراء.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#692f39',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'حذف نهائي',
                cancelButtonText: 'إلغاء'
            });
            if (result.isConfirmed) form.submit();
        });
    });
</script>
}
