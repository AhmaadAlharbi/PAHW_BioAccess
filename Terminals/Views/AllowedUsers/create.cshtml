@model Terminals.Web.DTOs.AllowedUserDto?
@{
    ViewData["Title"] = "إضافة عضو";
    var currentEmpId = Context.Session.GetString("EmpId") ?? "";
}

@if (TempData["ErrorMsg"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="fa-solid fa-circle-xmark"></i>
        <span>@TempData["ErrorMsg"]</span>
    </div>
}
@if (TempData["SuccessMsg"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["SuccessMsg"]</span>
    </div>
}

@* ── Step 1: Fetch employee data ─────────────────────── *@
<div class="allowed-users-page fade-in">
<div class="content-card mb-3">
    <div class="allowed-users-header mb-3">
        <div class="allowed-users-title">
            <span class="allowed-users-title-icon"><i class="fa-solid fa-user-plus"></i></span>
            <div>
                <h2>إضافة عضو</h2>
                <p>ابدأ بالرقم الوظيفي ثم راجع بيانات العضو وصلاحياته.</p>
            </div>
        </div>
        <a asp-controller="AllowedUsers" asp-action="Index" class="btn btn-outline btn-sm">
            <i class="fa-solid fa-arrow-right"></i>
            <span>العودة للقائمة</span>
        </a>
    </div>
    <h2 class="c-section-title">الخطوة 1 — جلب بيانات العضو</h2>
    <p class="text-muted small mb-3">أدخل الرقم الوظيفي لجلب بيانات العضو من النظام.</p>

    <form id="fetchUserForm" method="post" asp-action="Fetch">
        <div class="d-flex gap-2 align-items-end">
            <div class="flex-grow-1">
                <label class="form-label fw-bold">الرقم الوظيفي</label>
                <input type="number" name="employeeId" required
                       placeholder="مثال: 7300" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary u-nowrap">جلب البيانات</button>
        </div>
    </form>
</div>

@* ── Step 2: Review and save ──────────────────────────── *@
@if (Model is { } allowedUser)
{
    <div class="content-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="c-section-title">الخطوة 2 — مراجعة وحفظ البيانات</h2>
            <span class="badge badge-success"><i class="fa-solid fa-check"></i> <span>تم جلب البيانات</span></span>
        </div>

        <form id="saveUserForm" method="post" asp-action="Save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="employeeId" value="@allowedUser.EmployeeId" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">الاسم الكامل</label>
                    <input type="text" name="fullName" value="@allowedUser.FullName"
                           class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">البريد الإلكتروني</label>
                    <input type="email" name="email" value="@allowedUser.Email"
                           class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">القسم</label>
                    <input type="text" name="department" value="@allowedUser.Department"
                           class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">الرقم الوظيفي</label>
                    <input type="text" value="@allowedUser.EmployeeId"
                           class="form-control" readonly disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">نوع المستخدم</label>
                    <select name="userType" class="form-control" required>
                        <option value="Attendance" selected="@(allowedUser.UserType != "IT")">الدوام</option>
                        <option value="IT" selected="@(allowedUser.UserType == "IT")">تقنية المعلومات</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="permission-toggle" for="isAdmin">
                    <input type="checkbox" name="isAdmin" id="isAdmin"
                           value="true" class="permission-toggle-input" />
                    <span class="permission-toggle-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </span>
                    <span class="permission-toggle-text">
                        <span class="permission-toggle-title">منح صلاحية مشرف</span>
                        <span class="permission-toggle-description">المشرف يستطيع إدارة الأعضاء والمناطق والأجهزة وتنفيذ العمليات الإدارية.</span>
                    </span>
                    <span class="permission-toggle-control" aria-hidden="true"></span>
                </label>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-controller="AllowedUsers" asp-action="Index" class="btn btn-outline">إلغاء</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i>
                    <span>حفظ العضو</span>
                </button>
            </div>
        </form>
    </div>
}
else
{
    <div class="content-card">
        <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <div class="empty-state-text">أدخل الرقم الوظيفي في الخطوة الأولى أعلاه لجلب بيانات العضو</div>
        </div>
    </div>
}
</div>


@section Scripts {
    <script>
        var fetchUserForm = document.getElementById('fetchUserForm');
        var saveUserForm  = document.getElementById('saveUserForm');

        if (fetchUserForm) {
            fetchUserForm.addEventListener('submit', function () {
                var btn = fetchUserForm.querySelector('button[type="submit"]');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الجلب...';
                }
            });
        }

        if (saveUserForm) {
            saveUserForm.addEventListener('submit', async function (e) {
                var email = saveUserForm.querySelector('input[name="email"]')?.value || '';
                if (email && !email.includes('@@')) {
                    e.preventDefault();
                    await Swal.fire({
                        icon: 'warning',
                        title: 'تنبيه',
                        text: 'يرجى إدخال بريد إلكتروني صحيح',
                        confirmButtonColor: '#692f39',
                        confirmButtonText: 'حسناً'
                    });
                    return;
                }
                var btn = saveUserForm.querySelector('button[type="submit"]');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الحفظ...';
                }
            });
        }
    </script>
}
